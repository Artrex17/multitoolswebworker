---
import type { Lang } from '../../i18n/strings';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const t = {
  es: {
    heading: 'SVG a PNG/JPEG',
    file: 'Elige un archivo SVG',
    format: 'Formato de salida',
    download: 'Descargar resultado',
    error: 'No se pudo procesar el SVG. Comprueba que el archivo sea válido.',
  },
  en: {
    heading: 'SVG to PNG/JPEG',
    file: 'Choose an SVG file',
    format: 'Output format',
    download: 'Download result',
    error: 'Could not process the SVG. Check that the file is valid.',
  },
}[lang];
---

<section class="panel tool">
  <h1>{t.heading}</h1>
  <div class="controls">
    <label>{t.file}<input type="file" id="file" accept="image/svg+xml" /></label>
    <label>
      {t.format}
      <div class="rocker">
        <label class="rocker-option"><input type="radio" name="format" value="image/png" checked /><span>PNG</span></label>
        <label class="rocker-option"><input type="radio" name="format" value="image/jpeg" /><span>JPEG</span></label>
      </div>
    </label>
  </div>
  <p class="error-strip" id="error" role="alert" hidden>{t.error}</p>
  <div class="preview-area">
    <div class="preview-box" id="preview-box"></div>
  </div>
  <div class="actions">
    <a class="btn btn-primary" id="download" hidden download>{t.download}</a>
  </div>
</section>

<script>
  import { svgToRaster } from '../../lib/svg';

  const fileInput = document.querySelector<HTMLInputElement>('#file')!;
  const errorEl = document.querySelector<HTMLParagraphElement>('#error')!;
  const previewBox = document.querySelector<HTMLDivElement>('#preview-box')!;
  const downloadEl = document.querySelector<HTMLAnchorElement>('#download')!;

  let svgText: string | null = null;
  let previewUrl: string | null = null;
  let requestToken = 0;

  function currentMimeType() {
    return document.querySelector<HTMLInputElement>('input[name="format"]:checked')!.value as 'image/png' | 'image/jpeg';
  }

  async function updatePreview() {
    if (!svgText) return;
    errorEl.hidden = true;
    const token = ++requestToken;
    const mimeType = currentMimeType();
    try {
      const blob = await svgToRaster(svgText, mimeType);
      if (token !== requestToken) return;
      if (previewUrl) URL.revokeObjectURL(previewUrl);
      previewUrl = URL.createObjectURL(blob);
      previewBox.innerHTML = `<img src="${previewUrl}" alt="" />`;
      downloadEl.href = previewUrl;
      downloadEl.download = `converted.${mimeType === 'image/png' ? 'png' : 'jpg'}`;
      downloadEl.hidden = false;
    } catch {
      if (token === requestToken) errorEl.hidden = false;
    }
  }

  fileInput.addEventListener('change', async () => {
    const file = fileInput.files?.[0];
    if (!file) return;
    errorEl.hidden = true;
    try {
      svgText = await file.text();
      updatePreview();
    } catch {
      errorEl.hidden = false;
    }
  });

  document.querySelectorAll<HTMLInputElement>('input[name="format"]').forEach((el) => el.addEventListener('change', updatePreview));
</script>
