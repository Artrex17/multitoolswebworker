---
import type { Lang } from '../../i18n/strings';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const t = {
  es: {
    heading: 'Convertir, redimensionar y comprimir imagen',
    file: 'Elige una imagen (PNG, JPEG o WebP)',
    format: 'Formato de salida',
    quality: 'Calidad',
    maxWidth: 'Ancho máximo (px, opcional)',
    maxHeight: 'Alto máximo (px, opcional)',
    download: 'Descargar resultado',
    error: 'No se pudo procesar la imagen. Comprueba que el archivo sea válido.',
  },
  en: {
    heading: 'Convert, resize and compress image',
    file: 'Choose an image (PNG, JPEG or WebP)',
    format: 'Output format',
    quality: 'Quality',
    maxWidth: 'Max width (px, optional)',
    maxHeight: 'Max height (px, optional)',
    download: 'Download result',
    error: 'Could not process the image. Check that the file is valid.',
  },
}[lang];
---

<section class="panel tool">
  <h1>{t.heading}</h1>
  <div class="controls">
    <label>{t.file}<input type="file" id="file" accept="image/png,image/jpeg,image/webp" /></label>
    <label>
      {t.format}
      <div class="rocker">
        <label class="rocker-option"><input type="radio" name="format" value="webp" checked /><span>WebP</span></label>
        <label class="rocker-option"><input type="radio" name="format" value="png" /><span>PNG</span></label>
        <label class="rocker-option"><input type="radio" name="format" value="jpeg" /><span>JPEG</span></label>
      </div>
    </label>
    <label>{t.quality}<input type="range" id="quality" min="0.1" max="1" step="0.05" value="0.85" /></label>
    <div class="field-row">
      <label>{t.maxWidth}<input type="number" id="maxWidth" min="1" /></label>
      <label>{t.maxHeight}<input type="number" id="maxHeight" min="1" /></label>
    </div>
  </div>
  <p class="error-strip" id="error" role="alert" hidden>{t.error}</p>
  <div class="preview-area">
    <div class="preview-box" id="preview-box"></div>
  </div>
  <div class="actions">
    <a class="btn btn-primary" id="download" hidden download>{t.download}</a>
  </div>
</section>

<script>
  import { convertImage, type ImageFormat } from '../../lib/image';

  const fileInput = document.querySelector<HTMLInputElement>('#file')!;
  const errorEl = document.querySelector<HTMLParagraphElement>('#error')!;
  const previewBox = document.querySelector<HTMLDivElement>('#preview-box')!;
  const downloadEl = document.querySelector<HTMLAnchorElement>('#download')!;

  let bitmap: ImageBitmap | null = null;
  let previewUrl: string | null = null;
  let debounceTimer: number | undefined;
  let requestToken = 0;

  function readControls() {
    return {
      format: document.querySelector<HTMLInputElement>('input[name="format"]:checked')!.value as ImageFormat,
      quality: Number(document.querySelector<HTMLInputElement>('#quality')!.value),
      maxWidth: Number(document.querySelector<HTMLInputElement>('#maxWidth')!.value) || undefined,
      maxHeight: Number(document.querySelector<HTMLInputElement>('#maxHeight')!.value) || undefined,
    };
  }

  async function updatePreview() {
    if (!bitmap) return;
    errorEl.hidden = true;
    const token = ++requestToken;
    const { format, quality, maxWidth, maxHeight } = readControls();
    try {
      const blob = await convertImage(bitmap, format, quality, maxWidth, maxHeight);
      if (token !== requestToken) return;
      if (previewUrl) URL.revokeObjectURL(previewUrl);
      previewUrl = URL.createObjectURL(blob);
      previewBox.innerHTML = `<img src="${previewUrl}" alt="" />`;
      downloadEl.href = previewUrl;
      downloadEl.download = `converted.${format}`;
      downloadEl.hidden = false;
    } catch {
      if (token === requestToken) errorEl.hidden = false;
    }
  }

  function scheduleUpdate() {
    clearTimeout(debounceTimer);
    debounceTimer = window.setTimeout(updatePreview, 150);
  }

  fileInput.addEventListener('change', async () => {
    const file = fileInput.files?.[0];
    if (!file) return;
    errorEl.hidden = true;
    try {
      bitmap = await createImageBitmap(file);
      updatePreview();
    } catch {
      errorEl.hidden = false;
    }
  });

  document.querySelectorAll<HTMLInputElement>('input[name="format"]').forEach((el) => el.addEventListener('change', scheduleUpdate));
  document.querySelector('#quality')!.addEventListener('input', scheduleUpdate);
  document.querySelector('#maxWidth')!.addEventListener('input', scheduleUpdate);
  document.querySelector('#maxHeight')!.addEventListener('input', scheduleUpdate);
</script>
