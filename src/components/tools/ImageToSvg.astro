---
import type { Lang } from '../../i18n/strings';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const t = {
  es: {
    heading: 'PNG/JPEG a SVG (vectorizar)',
    file: 'Elige una imagen (PNG o JPEG)',
    profile: 'Perfil de vectorizado',
    detailed: 'Foto (alto detalle)',
    smoothed: 'Suave',
    sharp: 'Nítido',
    posterized2: 'Póster (pocos colores)',
    grayscale: 'Blanco y negro',
    removeColor: 'Eliminar un color (ej. el fondo)',
    colorLabel: 'Color a eliminar',
    tolerance: 'Tolerancia',
    pickHint: 'Con "eliminar color" activo, haz clic en la imagen original para elegir el color exacto',
    original: 'Original',
    vectorized: 'Vectorizado',
    download: 'Descargar SVG',
    processing: 'Vectorizando…',
    error: 'No se pudo vectorizar la imagen. Prueba con una imagen simple o de menor tamaño.',
  },
  en: {
    heading: 'PNG/JPEG to SVG (vectorize)',
    file: 'Choose an image (PNG or JPEG)',
    profile: 'Vectorize profile',
    detailed: 'Photo (high detail)',
    smoothed: 'Smooth',
    sharp: 'Sharp',
    posterized2: 'Poster (few colors)',
    grayscale: 'Black & white',
    removeColor: 'Remove a color (e.g. the background)',
    colorLabel: 'Color to remove',
    tolerance: 'Tolerance',
    pickHint: 'With "remove color" on, click the original image to pick the exact color',
    original: 'Original',
    vectorized: 'Vectorized',
    download: 'Download SVG',
    processing: 'Vectorizing…',
    error: 'Could not vectorize the image. Try a simpler or smaller image.',
  },
}[lang];

const presets = [
  { value: 'detailed', label: t.detailed },
  { value: 'smoothed', label: t.smoothed },
  { value: 'sharp', label: t.sharp },
  { value: 'posterized2', label: t.posterized2 },
  { value: 'grayscale', label: t.grayscale },
];
---

<section class="panel tool">
  <h1>{t.heading}</h1>
  <div class="controls">
    <label>{t.file}<input type="file" id="file" accept="image/png,image/jpeg" /></label>
    <label>
      {t.profile}
      <div class="rocker">
        {presets.map((p, i) => (
          <label class="rocker-option">
            <input type="radio" name="preset" value={p.value} checked={i === 0} />
            <span>{p.label}</span>
          </label>
        ))}
      </div>
    </label>
    <label class="toggle"><input type="checkbox" id="remove-toggle" /><span class="toggle-track"><span class="toggle-thumb"></span></span>{t.removeColor}</label>
    <div class="field-row" id="remove-controls" hidden>
      <label>{t.colorLabel}<input type="color" id="remove-color" value="#ffffff" /></label>
      <label>{t.tolerance}<input type="range" id="tolerance" min="0" max="120" step="1" value="40" /></label>
    </div>
    <p class="busy-note" id="pick-hint" hidden>{t.pickHint}</p>
  </div>
  <p class="error-strip" id="error" role="alert" hidden>{t.error}</p>
  <p class="busy-note" id="busy" hidden>{t.processing}</p>
  <div class="preview-area">
    <div>
      <p class="preview-label">{t.original}</p>
      <div class="preview-box" id="original-box"></div>
    </div>
    <div>
      <p class="preview-label">{t.vectorized}</p>
      <div class="preview-box" id="vector-box"></div>
    </div>
  </div>
  <div class="actions">
    <a class="btn btn-primary" id="download" hidden download>{t.download}</a>
  </div>
</section>

<style>
  #original-box.pickable img {
    cursor: crosshair;
  }
</style>

<script>
  import { createImageWorkerClient } from '../../lib/worker-client';
  import type { VectorizePreset } from '../../lib/svg';

  const client = createImageWorkerClient();
  const fileInput = document.querySelector<HTMLInputElement>('#file')!;
  const errorEl = document.querySelector<HTMLParagraphElement>('#error')!;
  const busyEl = document.querySelector<HTMLParagraphElement>('#busy')!;
  const pickHintEl = document.querySelector<HTMLParagraphElement>('#pick-hint')!;
  const originalBox = document.querySelector<HTMLDivElement>('#original-box')!;
  const vectorBox = document.querySelector<HTMLDivElement>('#vector-box')!;
  const downloadEl = document.querySelector<HTMLAnchorElement>('#download')!;
  const removeToggle = document.querySelector<HTMLInputElement>('#remove-toggle')!;
  const removeControls = document.querySelector<HTMLDivElement>('#remove-controls')!;
  const colorInput = document.querySelector<HTMLInputElement>('#remove-color')!;
  const toleranceInput = document.querySelector<HTMLInputElement>('#tolerance')!;

  let file: File | null = null;
  let originalUrl: string | null = null;
  let downloadUrl: string | null = null;
  let requestToken = 0;
  let debounceTimer: number | undefined;

  function currentPreset(): VectorizePreset {
    return document.querySelector<HTMLInputElement>('input[name="preset"]:checked')!.value as VectorizePreset;
  }

  function hexToRgb(hex: string) {
    const n = parseInt(hex.slice(1), 16);
    return { r: (n >> 16) & 255, g: (n >> 8) & 255, b: n & 255 };
  }

  function rgbToHex(r: number, g: number, b: number) {
    return '#' + [r, g, b].map((c) => c.toString(16).padStart(2, '0')).join('');
  }

  async function updateVector() {
    if (!file) return;
    errorEl.hidden = true;
    busyEl.hidden = false;
    const token = ++requestToken;
    const removal = removeToggle.checked
      ? { color: hexToRgb(colorInput.value), tolerance: Number(toleranceInput.value) }
      : undefined;
    try {
      const svg = await client.vectorize(file, currentPreset(), removal);
      if (token !== requestToken) return;
      vectorBox.innerHTML = svg;

      const blob = new Blob([svg], { type: 'image/svg+xml' });
      if (downloadUrl) URL.revokeObjectURL(downloadUrl);
      downloadUrl = URL.createObjectURL(blob);
      downloadEl.href = downloadUrl;
      downloadEl.download = 'vectorized.svg';
      downloadEl.hidden = false;
    } catch {
      if (token === requestToken) errorEl.hidden = false;
    } finally {
      if (token === requestToken) busyEl.hidden = true;
    }
  }

  function scheduleUpdate() {
    clearTimeout(debounceTimer);
    debounceTimer = window.setTimeout(updateVector, 150);
  }

  fileInput.addEventListener('change', () => {
    file = fileInput.files?.[0] ?? null;
    if (!file) return;
    errorEl.hidden = true;

    if (originalUrl) URL.revokeObjectURL(originalUrl);
    originalUrl = URL.createObjectURL(file);
    originalBox.innerHTML = `<img src="${originalUrl}" alt="" />`;

    updateVector();
  });

  document.querySelectorAll<HTMLInputElement>('input[name="preset"]').forEach((el) => {
    el.addEventListener('change', updateVector);
  });

  removeToggle.addEventListener('change', () => {
    removeControls.hidden = !removeToggle.checked;
    pickHintEl.hidden = !removeToggle.checked;
    originalBox.classList.toggle('pickable', removeToggle.checked);
    updateVector();
  });

  colorInput.addEventListener('input', scheduleUpdate);
  toleranceInput.addEventListener('input', scheduleUpdate);

  originalBox.addEventListener('click', async (event) => {
    if (!removeToggle.checked || !file) return;
    const img = originalBox.querySelector('img');
    if (!img) return;
    const rect = img.getBoundingClientRect();
    const x = Math.min(img.naturalWidth - 1, Math.max(0, Math.round(((event.clientX - rect.left) / rect.width) * img.naturalWidth)));
    const y = Math.min(img.naturalHeight - 1, Math.max(0, Math.round(((event.clientY - rect.top) / rect.height) * img.naturalHeight)));

    const { r, g, b } = await client.samplePixel(file, x, y);
    colorInput.value = rgbToHex(r, g, b);
    updateVector();
  });
</script>
