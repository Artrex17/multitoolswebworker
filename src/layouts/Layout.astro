---
import Nav from '../components/Nav.astro';
import AdSlot from '../components/AdSlot.astro';
import '../styles/global.css';
import { tools, type Lang } from '../i18n/strings';

interface Props {
  lang: Lang;
  title: string;
  description: string;
}
const { lang, title, description } = Astro.props;
const currentPath = new URL(Astro.request.url).pathname.replace(/\/$/, '') || `/${lang}`;

// Find this same page's URL in the other language, for hreflang alternates.
const otherLang: Lang = lang === 'es' ? 'en' : 'es';
const toolIndex = tools[lang].findIndex((item) => item.href === currentPath);
const otherLangPath = toolIndex === -1 ? `/${otherLang}/` : tools[otherLang][toolIndex].href;
const esPath = lang === 'es' ? currentPath : otherLangPath;
const enPath = lang === 'en' ? currentPath : otherLangPath;

const siteUrl = (Astro.site?.origin ?? 'https://multitoolswebworker.artrex17thephoenix.workers.dev').replace(/\/$/, '');
const canonicalUrl = `${siteUrl}${currentPath}/`;
const ogImageUrl = `${siteUrl}/og-image.png`;
const ogLocale = lang === 'es' ? 'es_ES' : 'en_US';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={`${siteUrl}${esPath}/`} />
    <link rel="alternate" hreflang="en" href={`${siteUrl}${enPath}/`} />
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${esPath}/`} />
    <link rel="icon" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="multitools" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Manrope:wght@400;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Nav lang={lang} currentPath={currentPath} />
    <div class="page">
      <AdSlot slot="1111111111" variant="sidebar" />
      <main>
        <AdSlot slot="2222222222" variant="horizontal" />
        <slot />
      </main>
      <AdSlot slot="3333333333" variant="sidebar" />
    </div>
    <footer>
      <p>© {new Date().getFullYear()} multitools</p>
    </footer>

    <dialog id="zoom-dialog" class="zoom-dialog">
      <div id="zoom-content"></div>
    </dialog>

    <script>
      const dialog = document.querySelector<HTMLDialogElement>('#zoom-dialog')!;
      const content = document.querySelector<HTMLDivElement>('#zoom-content')!;

      document.addEventListener('click', (event) => {
        const box = (event.target as HTMLElement).closest('.preview-box');
        if (!box) return;
        content.innerHTML = box.innerHTML;
        dialog.showModal();
      });

      dialog.addEventListener('click', () => dialog.close());
    </script>

    <style>
      .page {
        display: flex;
        align-items: flex-start;
        gap: 1.25rem;
        max-width: 1240px;
        margin: 0 auto;
        padding: 1.5rem 1.25rem 3rem;
      }
      main {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
      }
      @media (max-width: 900px) {
        .page :global(.ad-slot.sidebar) {
          display: none;
        }
      }
      footer {
        text-align: center;
        padding: 1.5rem;
        font-family: var(--font-mono);
        font-size: 0.8rem;
        color: var(--ink-soft);
        border-top: 1px solid rgba(42, 39, 35, 0.1);
      }
    </style>
  </body>
</html>
